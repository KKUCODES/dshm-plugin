{
  "name": "@dsh-mobile/plugin",
  "version": "0.1.84-latest.0",
  "type": "module",
  "description": "Connect the DSHM Android client to official DeepSeek Harness for remote conversations and approvals",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KKUCODES/dshm-plugin.git"
  },
  "homepage": "https://github.com/KKUCODES/dshm-plugin#readme",
  "keywords": ["deepseek", "deepseek-harness", "dsh-plugin", "dshm", "android", "remote", "device-pairing"],
  "engines": { "node": ">=24" },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "prepare:ci": "node scripts/prepare-ci.mjs",
    "build:ci": "node scripts/build-ci-package.mjs",
    "build:github": "node scripts/build-github-package.mjs",
    "check:github": "node scripts/check-github-package.mjs",
    "test:github": "node --test tests/github-package.test.mjs",
    "test:compat": "vitest run tests/profile-dsh-contract.test.ts tests/official-plugin-startup.test.ts tests/workspace-file-contract.test.ts && node --test tests/official-remote-endpoints.test.mjs",
    "verify:github": "node scripts/verify-github-install.mjs",
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "audit:official": "node scripts/audit-official-plugin-only-delivery.mjs",
    "audit:interfaces": "node scripts/audit-official-interfaces.mjs",
    "pack:local": "node scripts/check-github-package.mjs && npm pack --pack-destination artifacts --ignore-scripts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-modules": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-api-workspace-files": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment-local": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-credentials-local": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-fs-local": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-jobs-local": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-message-feedback": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-office-to-pdf": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-telemetry-otel": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-web-search-deepseek": "0.1.6-alpha.2",
    "@dsh-mobile/protocol": "file:../backend/packages/protocol",
    "@earendil-works/pi-ai": "0.85.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-modules": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-web-search-deepseek": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-config-editor": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.4 || 3.18.5-alpha.1"
  }
}
